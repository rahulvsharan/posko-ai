{
  "name": "posko-ai",
  "version": "0.1.0",
  "description": "Standalone OpenAI-compatible gateway (Bun + TypeScript) — OpenCode Zen + KiloCode free models",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "build": "bun build --compile src/index.ts --outfile dist/posko-ai",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "zod": "^3.24.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
